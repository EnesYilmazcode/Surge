# Local chat uses the Claude Code CLI signed in on this machine by default.
# SURGE_PROVIDER=codex uses the Codex CLI signed in on this machine instead (SURGE_CODEX_MODEL optional).
# SURGE_PROVIDER=gemini switches local chat back to Gemini.
SURGE_PROVIDER=claude
SURGE_CLAUDE_MODEL=opus
SURGE_CODEX_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
